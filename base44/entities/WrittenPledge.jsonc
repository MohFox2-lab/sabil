{
  "name": "WrittenPledge",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "student_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e"
    },
    "type": {
      "type": "string",
      "enum": [
        "\u0633\u0644\u0648\u0643\u064a",
        "\u0645\u0648\u0627\u0638\u0628\u0629"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u0647\u062f"
    },
    "content": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u062a\u0639\u0647\u062f"
    },
    "misconduct_related": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "signed_by_student": {
      "type": "boolean",
      "default": false,
      "description": "\u0648\u0642\u0639 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "signed_by_guardian": {
      "type": "boolean",
      "default": false,
      "description": "\u0648\u0642\u0639 \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631"
    }
  },
  "required": [
    "student_id",
    "date",
    "type",
    "content"
  ]
}