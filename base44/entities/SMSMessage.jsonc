{
  "name": "SMSMessage",
  "type": "object",
  "properties": {
    "message_type": {
      "type": "string",
      "enum": [
        "sms",
        "push_notification",
        "whatsapp"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "parent",
        "student",
        "teacher"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "student_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "student_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "group_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "group_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629"
    },
    "recipient_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "recipient_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u0644\u0645 (\u0644\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a)"
    },
    "message_content": {
      "type": "string",
      "description": "\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0645\u062c\u062f\u0648\u0644"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0641\u0639\u0644\u064a"
    },
    "template_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0644\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "sender_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0631\u0633\u0644"
    }
  },
  "required": [
    "message_type",
    "recipient_type",
    "message_content"
  ]
}