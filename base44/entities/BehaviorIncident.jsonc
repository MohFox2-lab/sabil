{
  "name": "BehaviorIncident",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "student_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "misconduct_type_id": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629"
    },
    "misconduct_title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0627\u062f\u062b\u0629"
    },
    "day_of_week": {
      "type": "string",
      "description": "\u0627\u0644\u064a\u0648\u0645 (\u0627\u0644\u0623\u062d\u062f\u060c \u0627\u0644\u0625\u062b\u0646\u064a\u0646...)"
    },
    "degree": {
      "type": "number",
      "description": "\u062f\u0631\u062c\u0629 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629"
    },
    "points_deducted": {
      "type": "number",
      "description": "\u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0645\u062d\u0633\u0648\u0645\u0629"
    },
    "actions_taken": {
      "type": "string",
      "description": "\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0645\u062a\u062e\u0630\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "procedure_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 (1-4)"
    }
  },
  "required": [
    "student_id",
    "misconduct_type_id",
    "date",
    "points_deducted"
  ]
}