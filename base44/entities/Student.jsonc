{
  "name": "Student",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "national_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 / \u0627\u0644\u0625\u0642\u0627\u0645\u0629"
    },
    "full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "first_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644"
    },
    "father_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0623\u0628"
    },
    "grandfather_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062c\u062f"
    },
    "family_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0627\u0626\u0644\u0629"
    },
    "nationality": {
      "type": "string",
      "description": "\u0627\u0644\u062c\u0646\u0633\u064a\u0629"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f"
    },
    "place_of_birth": {
      "type": "string",
      "description": "\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u064a\u0644\u0627\u062f"
    },
    "school_code": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062f\u0631\u0633\u0629"
    },
    "school_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062f\u0631\u0633\u0629"
    },
    "school_code_ministry": {
      "type": "string",
      "description": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0632\u0627\u0631\u064a"
    },
    "grade_level": {
      "type": "string",
      "enum": [
        "\u0627\u0628\u062a\u062f\u0627\u0626\u064a",
        "\u0645\u062a\u0648\u0633\u0637",
        "\u062b\u0627\u0646\u0648\u064a"
      ],
      "description": "\u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062f\u0631\u0627\u0633\u064a\u0629"
    },
    "grade_class": {
      "type": "number",
      "description": "\u0627\u0644\u0635\u0641 (1-12)"
    },
    "class_division": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0639\u0628\u0629"
    },
    "residential_address": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0633\u0643\u0646"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "district": {
      "type": "string",
      "description": "\u0627\u0644\u062d\u064a"
    },
    "behavior_score": {
      "type": "number",
      "default": 80,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0633\u0644\u0648\u0643 \u0627\u0644\u0625\u064a\u062c\u0627\u0628\u064a"
    },
    "distinguished_score": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0633\u0644\u0648\u0643 \u0627\u0644\u0645\u062a\u0645\u064a\u0632"
    },
    "attendance_score": {
      "type": "number",
      "default": 100,
      "description": "\u0627\u0644\u0645\u0648\u0627\u0638\u0628\u0629"
    },
    "guardian_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631"
    },
    "guardian_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u062c\u0648\u0627\u0644 \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631"
    },
    "guardian_work_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0639\u0645\u0644 \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631"
    },
    "student_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u062c\u0648\u0627\u0644 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "guardian_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "full_name",
    "student_id",
    "grade_level",
    "grade_class"
  ]
}