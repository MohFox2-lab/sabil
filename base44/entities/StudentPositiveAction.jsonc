      "description": "\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "positive_action_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0646\u0634\u0627\u0637"
    },
    "positive_action_title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0646\u0634\u0627\u0637"
    },
    "date": {
      "type": "string",
