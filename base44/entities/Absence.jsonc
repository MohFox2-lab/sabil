{
  "name": "Absence",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "student_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u063a\u064a\u0627\u0628"
    },
    "has_excuse": {
      "type": "boolean",
      "default": false,
      "description": "\u064a\u0648\u062c\u062f \u0639\u0630\u0631"
    },
    "excuse_type": {
      "type": "string",
      "enum": [
        "\u0627\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0645\u0631\u0636\u064a\u0629",
        "\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u064a\u0627\u062a \u0648\u0627\u0644\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u0635\u062d\u064a\u0629",
        "\u062d\u062f\u0648\u062b \u0627\u0644\u0643\u0648\u0627\u0631\u062b",
        "\u0648\u0641\u0627\u0629 \u0623\u062d\u062f \u0627\u0644\u0623\u0642\u0627\u0631\u0628",
        "\u0645\u0631\u0627\u0641\u0642\u0629 \u0635\u062d\u064a\u0629",
        "\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629",
        "\u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0633\u0627\u0628\u0642\u0627\u062a",
        "\u0638\u0631\u0648\u0641 \u0635\u062d\u064a\u0629 \u0623\u062e\u0631\u0649",
        "\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0637\u0641\u0644",
        "\u0623\u062e\u0631\u0649"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0630\u0631"
    },
    "excuse_document_url": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0627\u0644\u0639\u0630\u0631"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "points_deducted": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062f\u0631\u062c\u0627\u062a \u0627\u0644\u0645\u062d\u0633\u0648\u0645\u0629"
    }
  },
  "required": [
    "student_id",
    "date"
  ]
}